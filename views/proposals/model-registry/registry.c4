// The RDF database / model registry next to powsybl-core, under the proposal that the registry (today cgmes-rdfdb)
// becomes a repository of its own. Light fills with dark text (doc_* colours of 00-specification.c4). Figures on the
// edges are medians of scratchpad/reports/16-benchmark-campaign.md §0 and 21-benchmarks.md (IGM = sv6 replica,
// 21 k terminals; sv20 = 70 k terminals): putAsDiff day ≈ 53 s IGM Fuseki (16 §0); rich timestep 868 ms memory /
// 1 145 ms Fuseki at sv20 (16 §0); cold DB load 2.1–2.3 s IGM Fuseki (16 §0); diff route = update at depth 50, 93 ms
// sv6 Fuseki (21, u50); loadVariants of 96 rich timesteps 4 685 ms IGM Fuseki (16 §0); difference document of all
// generators + loads 38.5 ms sv20 (16 §0).
views 'RDF database integration: proposal' {

  view rdfdb-integration {
    title 'Model registry in its own repository, next to powsybl-core'
    description 'powsybl-core keeps the IIDM network, the CGMES conversion (families + sink), the in-place import of a difference, the NetworkEventRecorder and the thin triple store over a SPARQL endpoint. The model registry (today cgmes-rdfdb) moves to a repository of its own: the catalogue addressed by (scenario, timestep, version), the version graph and checkpoints, the loader with its diff and full routes, and the ingest of a day. The store is any SPARQL 1.1 + Graph Store Protocol endpoint (e.g. Fuseki) or the in-process memory: backend. Three flows: a TSO ingests 96 SSH timesteps as differences, a study tool loads (scenario, 08:30, v1.1) by the diff route into a variant, an operator writes a change back as a new version. One scenario per ModelingAuthoritySet is proposed, not implemented.'

    group 'Actors' {
      color gray
      opacity 0%
      include rdfdb_integration_tso with { description 'Base day + 96 SSH file sets' }
      include rdfdb_integration_study_tool with { description 'Wants (scenario, 08:30, v1.1)' }
      include rdfdb_integration_operator with { description 'Edits a variant, writes it back' }
    }

    group 'powsybl-core (upstream)' {
      color gray
      opacity 8%
      include powsybl_core.iidm.network with {
        title 'IIDM Network'
        description 'Variants: one per snapshot'
      }
      include proposed_unified_mapping.families with {
        title 'CGMES import / export'
        description 'Conversion, families + sink, CgmesDiffExport'
      }
      include proposed_diffstacking.cgmes_diff_import with {
        title 'CgmesDiffImport'
        description 'Applies a difference in place'
      }
      include powsybl_core.iidm.variants.network_event_recorder with {
        title 'NetworkEventRecorder'
        description 'Change log of a network'
      }
      include proposed_diffstacking.triple_store_sparql with {
        title 'triple-store-impl-rdf4j-sparql'
        description 'Thin SPARQL + Graph Store client'
      }
    }

    group 'Model registry (separate repository, e.g. powsybl-cgmes-registry)' {
      color blue
      opacity 8%
      include proposed_diffstacking.cgmes_rdfdb.snapshot_catalog with {
        title 'SnapshotCatalog'
        description 'putFull / putDiff / putAsDiff, (scenario, timestep, version)'
      }
      include proposed_diffstacking.cgmes_rdfdb.version_graph with {
        title 'VersionGraph + Checkpoint'
        description 'Plan NOOP | DIFF | FULL; fold a chain'
      }
      include proposed_diffstacking.cgmes_rdfdb.rdf_db_network_loader with {
        title 'RdfDbNetworkLoader'
        description 'load / update / loadVariants: diff or full route'
      }
      include proposed_diffstacking.cgmes_rdfdb.triple_diff_calculator with {
        title 'Ingest'
        description 'IngestParser + TripleDiffCalculator (StatementDiff)'
      }
      include proposed_rdfdb_scenario_per_mas with {
        title 'Scenario per ModelingAuthoritySet'
        description 'Proposed: multi-TSO CGM = scenarios + boundary'
      }
    }

    include proposed_diffstacking_rdf_database with {
      title 'RDF store: any SPARQL 1.1 + Graph Store endpoint (e.g. Fuseki) or in-process memory:'
      description 'Any SPARQL 1.1 + GSP endpoint (e.g. Fuseki) or memory:'
    }
    include proposed_diffstacking_rdf_database.store_meta_graph with { description 'Mutable catalogue, one per scenario' }
    include proposed_diffstacking_rdf_database.store_data_graphs with { description 'One per CGMES file, written once' }
    include proposed_diffstacking_rdf_database.store_diff_graphs with { description 'What a difference sets / replaced' }
    include proposed_diffstacking_rdf_database.store_checkpoint_copies with { description 'A chain folded on the server' }

    group 'Legend' {
      color gray
      opacity 0%
      include rdfdb_integration_legend.core with { title 'Grey: powsybl-core'; description 'Stays upstream' }
      include rdfdb_integration_legend.registry with { title 'Blue: model registry'; description 'Separate repository' }
      include rdfdb_integration_legend.store with { title 'Green: RDF store'; description 'Any SPARQL 1.1 + GSP endpoint' }
      include rdfdb_integration_legend.proposed with { title 'Dashed: proposed'; description 'Not implemented' }
    }

    exclude powsybl_core, powsybl_core.iidm, powsybl_core.iidm.variants, powsybl_core.cgmes, proposed_diffstacking.cgmes_rdfdb,
      proposed_unified_mapping, rdfdb_integration_legend
    exclude * -> *

    // TSO: a day ingested as differences
    include rdfdb_integration_tso -> proposed_diffstacking.cgmes_rdfdb.snapshot_catalog with { title 'putAsDiff ×96 ≈ 53 s IGM' }
    include proposed_diffstacking.cgmes_rdfdb.snapshot_catalog -> proposed_diffstacking.cgmes_rdfdb.triple_diff_calculator with { title 'rich timestep ≈ 0.9–1.1 s sv20' }
    include proposed_rdfdb_scenario_per_mas -> proposed_diffstacking.cgmes_rdfdb.snapshot_catalog with { title 'one scenario per TSO' }

    // Study tool: one moment by the diff route
    include rdfdb_integration_study_tool -> proposed_diffstacking.cgmes_rdfdb.rdf_db_network_loader with { title 'load (sc, 08:30, v1.1)' }
    include proposed_diffstacking.cgmes_rdfdb.rdf_db_network_loader -> proposed_diffstacking.cgmes_rdfdb.version_graph with { title 'plan: one chain query' }
    include proposed_diffstacking.cgmes_rdfdb.rdf_db_network_loader -> proposed_diffstacking.cgmes_diff_import with { title 'diff route ≈ 0.1 s sv6' }
    include proposed_diffstacking.cgmes_rdfdb.rdf_db_network_loader -> proposed_unified_mapping.families with { title 'full route: cold ≈ 2 s IGM' }
    include proposed_diffstacking.cgmes_diff_import -> powsybl_core.iidm.network with { title '96 variants ≈ 4.7 s IGM' }
    include proposed_unified_mapping.families -> powsybl_core.iidm.network with { title 'builds / updates' }

    // Operator: a change written back
    include rdfdb_integration_operator -> powsybl_core.iidm.network with { title 'changes a variant' }
    include powsybl_core.iidm.variants.network_event_recorder -> powsybl_core.iidm.network with { title 'records changes of' }
    include powsybl_core.iidm.variants.network_event_recorder -> proposed_unified_mapping.families with { title 'difference model ≈ 39 ms sv20' }
    include proposed_unified_mapping.families -> proposed_diffstacking.cgmes_rdfdb.snapshot_catalog with { title 'putDiff (RdfDbExport)' }

    // Registry to store, through the thin client of powsybl-core
    include proposed_diffstacking.cgmes_rdfdb.snapshot_catalog -> proposed_diffstacking.triple_store_sparql with { title 'one guarded SPARQL UPDATE' }
    include proposed_diffstacking.cgmes_rdfdb.version_graph -> proposed_diffstacking.triple_store_sparql with { title 'chain query; Checkpoint COPY' }
    include proposed_diffstacking.cgmes_rdfdb.rdf_db_network_loader -> proposed_diffstacking.triple_store_sparql with { title 'parallel GSP GET' }
    include proposed_diffstacking.triple_store_sparql -> proposed_diffstacking_rdf_database with { title 'SPARQL 1.1 + GSP' }
    include proposed_diffstacking_rdf_database.store_meta_graph -> proposed_diffstacking_rdf_database.store_data_graphs with { title 'indexes' }
    include proposed_diffstacking_rdf_database.store_meta_graph -> proposed_diffstacking_rdf_database.store_diff_graphs with { title 'indexes' }
    include proposed_diffstacking_rdf_database.store_checkpoint_copies -> proposed_diffstacking_rdf_database.store_diff_graphs with { title 'folds' }

    style * {
      color doc_unchanged
      textSize lg
    }
    style proposed_diffstacking.cgmes_rdfdb.*, proposed_rdfdb_scenario_per_mas, rdfdb_integration_legend.registry {
      color doc_reworked
    }
    style proposed_diffstacking_rdf_database, proposed_diffstacking_rdf_database.*, rdfdb_integration_legend.store {
      color doc_output
    }
    style proposed_rdfdb_scenario_per_mas, rdfdb_integration_legend.proposed {
      border dashed
    }
    style rdfdb_integration_tso, rdfdb_integration_study_tool, rdfdb_integration_operator {
      shape person
      color doc_rule
    }
    style rdfdb_integration_legend.* {
      size sm
    }
    rank source {
      rdfdb_integration_tso, rdfdb_integration_study_tool, rdfdb_integration_operator
    }
    rank source {
      rdfdb_integration_legend.core, rdfdb_integration_legend.registry, rdfdb_integration_legend.store,
      rdfdb_integration_legend.proposed
    }
    rank sink {
      proposed_diffstacking_rdf_database.store_data_graphs, proposed_diffstacking_rdf_database.store_diff_graphs
    }
    autoLayout TopBottom 50 30
  }
}
