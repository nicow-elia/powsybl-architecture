specification {
  element repository
  element module
  element api
  element provider
  element engine
  element adapter
  element model
  element component
  element binding
  element library
}

model {
  powsybl_open_loadflow = repository 'powsybl-open-loadflow' 'Provider implementations and numerical engines for Powsybl steady-state analyses.' {
    open_loadflow_provider = provider 'OpenLoadFlowProvider' 'Implements LoadFlowProvider for AC and DC load flows.'
    open_sensitivity_provider = provider 'OpenSensitivityAnalysisProvider' 'Implements SensitivityAnalysisProvider.'
    open_security_provider = provider 'OpenSecurityAnalysisProvider' 'Implements SecurityAnalysisProvider.'

    ac_dc_loadflow_engines = engine 'AC/DC load-flow engines' 'AcloadFlowEngine, DcLoadFlowEngine, AC solvers, and outer loops.' {
      load_flow_request = api 'Load-flow run and OpenLoadFlowParameters' 'Selects the AC solver, topology options, controls, and reporting level.'
      ac_load_flow_engine = engine 'AcloadFlowEngine' 'Coordinates AC equation construction, solver calls, outer loops, and final status.'
      dc_load_flow_engine = engine 'DcLoadFlowEngine' 'Coordinates classic DC load flow.'
      ac_solver_factory = component 'AcSolverFactory' 'Validates parameter compatibility and selects the configured AC solver.'
      newton_raphson = engine 'Newton-Raphson solver' 'Default nonlinear AC solver.'
      newton_krylov = engine 'Newton-Krylov solver' 'Nonlinear AC solver using Krylov methods.'
      fast_decoupled = engine 'Fast-Decoupled solver' 'AC solver that separates active/angle and reactive/voltage-magnitude iterations.'
      outer_loop_chain = component 'AC outer-loop chain' 'Voltage, reactive-limit, phase-shifter, and active-power-distribution controls that may request another solve.'
    }
    sensitivity_engines = engine 'AC/DC sensitivity engines' 'AcSensitivityAnalysis and DcSensitivityAnalysis.'
    security_analysis_engines = engine 'Security analysis engines' 'AcSecurityAnalysis, DcSecurityAnalysis, and WoodburyDcSecurityAnalysis.'

    equation_toolkit = module 'Equation builder toolkits' 'Equation-system infrastructure and AC/DC builders used by the numerical engines.' {
      equation_system = model 'EquationSystem and Jacobian infrastructure' 'EquationSystem, EquationTerm, EquationArray, VariableSet, TargetVector, StateVector, JacobianMatrix, and JacobianMatrixFastDecoupled.'
      ac_equation_builder = component 'AC equation builders' 'AcEquationSystemCreator and AcEquationSystemUpdater.'
      dc_equation_builder = component 'DC equation builders' 'DcEquationSystemCreator and DcEquationSystemUpdater.'
    }

    lf_network_adapter = adapter 'IIDM to LfNetwork adapter' 'Networks, LfNetworkLoaderImpl, and equipment-specific Lf* adapters.' {
      network_loader = component 'Networks and LfNetworkLoader' 'Builds the solver-facing topology and reconnectable elements from IIDM.'
    }
    lf_network = model 'LfNetwork' 'Solver-facing electrical network, topology, equations, and state.'
    contingency_propagation = adapter 'Contingency propagation' 'PropagatedContingency, ContingencyTripping, and node/breaker traversal.'
    state_and_result_mapping = adapter 'IIDM state and core-result mapping' 'Updates IIDM state and adapts solver outputs to Core result contracts.'
    network_cache = component 'NetworkCache' 'NetworkListener-backed cache for incremental AC load-flow runs.' {
      iidm_change_events = component 'IIDM NetworkListener changes' 'IIDM mutations notify the cache about changed equipment, parameters, and topology.'
      cache_input = component 'LfInput fingerprint' 'Captures load-flow and Open Load Flow parameters used to decide whether a cached entry remains valid.'
      network_cache_entry = component 'Generic NetworkCache entry' 'Owns the cache lifecycle, working variant cleanup, pause guard, and invalidation state for one IIDM Network.'
      ac_cache_value = component 'AC cached value' 'AcLoadFlowContext and its LfNetwork value.'
      dc_cache_value = component 'DC cached value' 'DcLoadFlowContext and its LfNetwork value.'
      change_classifier = component 'Network and topology update classifier' 'Distinguishes network updates from topology updates so state reset can be limited.'
      ac_fast_restart = engine 'AcLoadFlowFromCache' 'Reuses a cached AC computation network when the input is still compatible.'
      dc_fast_restart = engine 'DcLoadFlowFromCache' 'Reuses a cached DC computation network and avoids unnecessary state reset and voltage write-back.'
    }

    open_loadflow_provider -> ac_dc_loadflow_engines 'runs AC or DC calculation'
    open_loadflow_provider -> lf_network_adapter 'loads the computation network'
    ac_dc_loadflow_engines -> lf_network 'runs AC or DC calculation on'
    ac_dc_loadflow_engines -> equation_toolkit 'builds AC and DC equations with'
    ac_dc_loadflow_engines -> state_and_result_mapping 'returns results for write-back'
    lf_network_adapter -> lf_network 'builds and configures'
    lf_network -> equation_toolkit 'supplies variables and network state to'
    network_cache -> lf_network 'reuses and invalidates'

    ac_dc_loadflow_engines.load_flow_request -> lf_network_adapter.network_loader 'configures'
    ac_dc_loadflow_engines.load_flow_request -> ac_dc_loadflow_engines.ac_load_flow_engine 'configures'
    lf_network_adapter.network_loader -> lf_network 'builds and configures'
    lf_network -> ac_dc_loadflow_engines.ac_load_flow_engine 'provides loaded network to'
    ac_dc_loadflow_engines.ac_load_flow_engine -> equation_toolkit.ac_equation_builder 'creates and updates AC equations through'
    ac_dc_loadflow_engines.dc_load_flow_engine -> equation_toolkit.dc_equation_builder 'creates and updates DC equations through'
    ac_dc_loadflow_engines.ac_load_flow_engine -> ac_dc_loadflow_engines.ac_solver_factory 'selects a solver through'
    equation_toolkit.ac_equation_builder -> equation_toolkit.equation_system 'constructs and updates'
    equation_toolkit.dc_equation_builder -> equation_toolkit.equation_system 'constructs and updates'
    equation_toolkit.equation_system -> ac_dc_loadflow_engines.newton_raphson 'supplies equations to'
    equation_toolkit.equation_system -> ac_dc_loadflow_engines.newton_krylov 'supplies equations to'
    equation_toolkit.equation_system -> ac_dc_loadflow_engines.fast_decoupled 'supplies equations to'
    ac_dc_loadflow_engines.ac_solver_factory -> ac_dc_loadflow_engines.newton_raphson 'creates when selected'
    ac_dc_loadflow_engines.ac_solver_factory -> ac_dc_loadflow_engines.newton_krylov 'creates when selected'
    ac_dc_loadflow_engines.ac_solver_factory -> ac_dc_loadflow_engines.fast_decoupled 'creates when selected'
    ac_dc_loadflow_engines.newton_raphson -> ac_dc_loadflow_engines.outer_loop_chain 'returns state to'
    ac_dc_loadflow_engines.newton_krylov -> ac_dc_loadflow_engines.outer_loop_chain 'returns state to'
    ac_dc_loadflow_engines.fast_decoupled -> ac_dc_loadflow_engines.outer_loop_chain 'returns state to'
    ac_dc_loadflow_engines.outer_loop_chain -> ac_dc_loadflow_engines.ac_load_flow_engine 'updates controls and requests another pass from'
    ac_dc_loadflow_engines.ac_load_flow_engine -> state_and_result_mapping 'writes final state through'

    network_cache.iidm_change_events -> network_cache.network_cache_entry 'notifies'
    network_cache.cache_input -> network_cache.network_cache_entry 'validates inputs for'
    network_cache.network_cache_entry -> network_cache.ac_cache_value 'owns AC value'
    network_cache.network_cache_entry -> network_cache.dc_cache_value 'owns DC value'
    network_cache.iidm_change_events -> network_cache.change_classifier 'classifies changes through'
    network_cache.change_classifier -> network_cache.network_cache_entry 'marks cached values for update'
    network_cache.ac_cache_value -> network_cache.ac_fast_restart 'reuses'
    network_cache.dc_cache_value -> network_cache.dc_fast_restart 'reuses'
    network_cache.ac_fast_restart -> state_and_result_mapping 'writes completed AC state through'
    network_cache.dc_fast_restart -> state_and_result_mapping 'writes completed DC state through'

    open_sensitivity_provider -> sensitivity_engines 'runs sensitivity calculation'
    open_sensitivity_provider -> open_loadflow_provider 'uses the configured base-case load-flow provider'
    sensitivity_engines -> lf_network_adapter 'loads base-case topology'
    sensitivity_engines -> lf_network 'computes derivatives on'
    sensitivity_engines -> equation_toolkit 'reuses factorized Jacobians from'

    open_security_provider -> security_analysis_engines 'runs pre/post-contingency simulations'
    security_analysis_engines -> contingency_propagation 'converts and applies outages'
    security_analysis_engines -> lf_network_adapter 'creates topology-specific networks'
    security_analysis_engines -> state_and_result_mapping 'maps security results'
    contingency_propagation -> lf_network 'produces LfContingency operations for'
  }
}

views {
  view index of powsybl_open_loadflow {
    title 'powsybl-open-loadflow Components'
    include *
  }
}