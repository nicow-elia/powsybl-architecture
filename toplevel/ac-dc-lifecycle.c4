// Cross-repository views model public integration surfaces locally so the
// multi-project picker stays free of cross-project relationship arrows.
model {
  detailed_ac_dc_iidm = model 'powsybl-core: detailed AC/DC IIDM' 'The shared IIDM Network contains explicit AC and DC topology.' {
    detailed_dc_topology = component 'IIDM detailed DC topology' 'DcNode, DcBus, DcLine, DcSwitch, DcGround, and DcTerminal form the explicit DC network.'
    ac_dc_converters = component 'IIDM AC/DC converters' 'LCC and VSC converters couple AC terminals to DC terminals, with control modes, losses, and active-power bounds.'
    dc_format_io = adapter 'DC-capable format I/O' 'CGMES and IIDM format providers construct and serialize detailed DC equipment where supported.'
    dc_connectivity = component 'DC connectivity and mutations' 'DC connection state and topology changes are held on the shared Network.'

    dc_format_io -> detailed_dc_topology 'constructs and serializes'
    detailed_dc_topology -> ac_dc_converters 'connects through DC terminals'
    dc_connectivity -> detailed_dc_topology 'changes the active topology of'
  }

  detailed_ac_dc_olf = module 'powsybl-open-loadflow: coupled AC/DC load flow' {
    ac_dc_network_parameter = component 'acDcNetwork parameter' 'Selects the detailed AC/DC load-flow formulation.'
    ac_dc_loader = adapter 'IIDM to coupled LfNetwork loader' 'Builds AC buses, DC buses, DC branches, and converter representations.'
    coupled_lf_network = model 'Coupled LfNetwork' 'Solver-facing AC and DC state, including synchronous components and converter couplings.'
    ac_dc_newton_raphson = engine 'AC/DC Newton-Raphson execution' 'Solves the coupled AC/DC equation system. Classic DC load flow and alternate AC solvers are not used in this mode.'
    ac_dc_result_mapping = adapter 'IIDM state and Core result mapping' 'Writes converged electrical state back to IIDM and creates LoadFlow results.'

    ac_dc_network_parameter -> ac_dc_newton_raphson 'selects'
    ac_dc_loader -> coupled_lf_network 'builds'
    coupled_lf_network -> ac_dc_newton_raphson 'supplies coupled equations to'
    ac_dc_newton_raphson -> ac_dc_result_mapping 'produces converged state for'
  }

  detailed_ac_dc_python = module 'pypowsybl: detailed DC surface' {
    dc_dataframes = api 'Network DC DataFrames and mutation APIs' 'Exposes DC equipment, converter attributes, connection state, and solved values through pandas DataFrames.'
    ac_dc_opf = engine 'AC/DC OPF prototype' 'A separate Python optimization model that adds DC voltages, currents, converter constraints, and an AC/DC objective.'

    ac_dc_opf -> dc_dataframes 'reads inputs and writes solved values through'
  }

  detailed_ac_dc_iidm.detailed_dc_topology -> detailed_ac_dc_olf.ac_dc_loader 'maps the explicit DC topology into'
  detailed_ac_dc_iidm.ac_dc_converters -> detailed_ac_dc_olf.ac_dc_loader 'maps converter controls and limits into'
  detailed_ac_dc_olf.ac_dc_result_mapping -> detailed_ac_dc_iidm 'updates the shared Network'
  detailed_ac_dc_python.dc_dataframes -> detailed_ac_dc_iidm 'reads and mutates through the native bridge'
  detailed_ac_dc_python.ac_dc_opf -> detailed_ac_dc_iidm 'optimizes a separate model over'
}