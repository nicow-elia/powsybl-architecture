views {
  view contingency_and_corrective_action_flow {
    title 'Contingency and Corrective-Action State Flow'
    description 'Core supplies contingencies, actions, operator strategies, and state monitors. Open Load Flow creates N, N-1, and post-action states, evaluates limits, then maps the selected results back to Core. The contract supports post-strategy sensitivity contexts; provider and load-flow-model support can differ by analysis mode.'

    include core_study_contracts.study_apis
    include core_study_contracts.contingencies_and_contexts
    include core_study_contracts.action_definitions
    include core_study_contracts.operator_strategies
    include core_study_contracts.state_monitors
    include core_study_contracts.selected_loading_limits
    include olf_study_execution.propagated_contingencies
    include olf_study_execution.lf_actions_and_strategies
    include olf_study_execution.pre_contingency_state
    include olf_study_execution.post_contingency_state
    include olf_study_execution.post_action_state
    include olf_study_execution.limit_violation_evaluator
    include olf_study_execution.study_result_mapping
    autoLayout LeftRight

    style core_study_contracts.* {
      color indigo
    }
    style olf_study_execution.* {
      color green
    }
  }

  view analysis_configuration_and_result_selection {
    title 'Analysis Configuration and Result Selection'
    description 'Configuration originates in application code, JSON, and PlatformConfig; pypowsybl marshals Python parameters through its native bridge. Core combines common parameters, selected loading limits, and state-monitor filters with OLF provider extensions. OLF maps only relevant monitored N-1 deltas and violations back into Core and pandas results.'

    include study_configuration_sources
    include python_study_surface.*
    include core_study_contracts.study_apis
    include core_study_contracts.common_study_parameters
    include core_study_contracts.state_monitors
    include core_study_contracts.selected_loading_limits
    include core_study_contracts.modified_result_parameters
    include olf_study_execution.provider_parameter_extensions
    include olf_study_execution.pre_contingency_state
    include olf_study_execution.post_contingency_state
    include olf_study_execution.limit_violation_evaluator
    include olf_study_execution.monitored_result_filter
    include olf_study_execution.study_result_mapping
    autoLayout LeftRight

    style study_configuration_sources {
      color gray
    }
    style python_study_surface.* {
      color sky
    }
    style core_study_contracts.* {
      color indigo
    }
    style olf_study_execution.* {
      color green
    }
  }
}