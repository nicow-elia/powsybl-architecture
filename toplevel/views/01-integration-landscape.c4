views {
  view index {
    title 'Powsybl: APIs, Python bindings, and providers'
    description 'pypowsybl binds Powsybl public APIs into Python objects and pandas DataFrames. powsybl-core owns the IIDM Network and provider SPIs. powsybl-open-loadflow supplies the AC/DC load-flow, sensitivity, and security-analysis provider implementations selected by Core.'

    include python_surface
    include java_bridge
    include iidm_network
    include analysis_apis
    include contingency_api
    include provider_discovery
    include analysis_providers
    include lf_network_adapter
    include contingency_propagation
    autoLayout LeftRight

    style python_surface, java_bridge {
      color sky
    }
    style iidm_network, analysis_apis, contingency_api, provider_discovery {
      color indigo
    }
    style analysis_providers, lf_network_adapter, contingency_propagation {
      color green
    }
  }
}