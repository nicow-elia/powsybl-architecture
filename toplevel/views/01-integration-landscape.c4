import { powsybl_core } from 'powsybl-core'
import { powsybl_open_loadflow } from 'powsybl-open-loadflow'

views {
  view index {
    title 'Powsybl: APIs, Python bindings, and providers'
    description 'pypowsybl binds Powsybl public APIs into Python objects and pandas DataFrames. powsybl-core owns the IIDM Network and provider SPIs. powsybl-open-loadflow supplies the AC/DC load-flow, sensitivity, and security-analysis provider implementations selected by Core.'

    include python_surface
    include java_bridge
    include powsybl_core.iidm.network
    include analysis_apis
    include powsybl_core.contingency_api
    include provider_discovery
    include analysis_providers
    include powsybl_open_loadflow.lf_network_adapter
    include powsybl_open_loadflow.contingency_propagation
    autoLayout LeftRight

    style python_surface, java_bridge {
      color sky
    }
    style powsybl_core.iidm.network,
      analysis_apis,
      powsybl_core.contingency_api,
      provider_discovery {
      color indigo
    }
    style analysis_providers,
      powsybl_open_loadflow.lf_network_adapter,
      powsybl_open_loadflow.contingency_propagation {
      color green
    }
  }
}