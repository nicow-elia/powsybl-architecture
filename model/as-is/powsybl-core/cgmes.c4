model {
  extend powsybl_core {
    cgmes = module 'CGMES conversion' 'Import and export of CGMES grid models.' {
      link https://powsybl.readthedocs.io/projects/powsybl-core/en/latest/grid_exchange_formats/cgmes/index.html

      triple_store = library 'Triple store (rdf4j)' 'RDF store the CGMES import loads instance files into and queries through SPARQL.' {
        link https://powsybl.readthedocs.io/projects/powsybl-core/en/latest/grid_exchange_formats/cgmes/import.html
      }
      cgmes_model = component 'cgmes-model' 'CGMES vocabulary, profiles and metadata models, with no dependency on IIDM.' {
        link https://powsybl.readthedocs.io/projects/powsybl-core/en/latest/grid_exchange_formats/cgmes/index.html
      }
      conversion_update = component 'Conversion.update (SSH update workflow)' 'The ordinary CGMES update: SPARQL queries over the loaded instance files, then XxxConversion.update per equipment.' {
        link https://javadoc.io/doc/com.powsybl/powsybl-cgmes-conversion/latest/com.powsybl.cgmes.conversion/com/powsybl/cgmes/conversion/Conversion.html
      }
    }
  }

  powsybl_core.iidm.io.import_providers.cgmes_importer -> powsybl_core.cgmes.triple_store 'loads files into'
  powsybl_core.cgmes.conversion_update -> powsybl_core.cgmes.triple_store 'queries'
  powsybl_core.cgmes.conversion_update -> powsybl_core.iidm.network 'updates in place'
}
