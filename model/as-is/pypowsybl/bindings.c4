model {
  extend pypowsybl {
    python_api = api 'Python domain APIs' 'network, loadflow, security, sensitivity, and other Python facades.' {
      link https://powsybl.readthedocs.io/projects/pypowsybl/en/stable/reference/index.html
    }
    python_network = component 'pypowsybl.network.Network' 'Network._handle retains the opaque Java object handle across native calls.' {
      link https://powsybl.readthedocs.io/projects/pypowsybl/en/stable/reference/network.html
    }
    python_event_recorder = component 'pypowsybl.network.NetworkEventRecorder' 'Context manager; holds the handle of a Java NetworkEventRecording and exports partial SSH / CGMES difference models as strings, files or zip.'
    python_rdf_database = component 'pypowsybl.network.RdfDatabase' 'Context manager over the handle of a Java RdfDbConnection: connect_rdf_db / connect, load_cgmes, checkpoint, clear, and the catalogue views scenarios / snapshots / versions / timesteps / models as dataframes. Every call names the scenario - the base grid model, in practice the day - as its second positional argument, and addresses a state inside it by version and timestep.'
    pybind_extension = binding '_pypowsybl pybind11 extension' 'The C++ extension module used by the Python API.'
    native_image_bridge = binding 'GraalVM native-image bridge' 'PowsyblCaller and GraalVmGuard cross the native-image isolate boundary.'
    java_bindings = module 'Java C entry points' 'GraalVM @CEntryPoint functions that hold Java object handles and call public Powsybl APIs.' {
      network_c_functions = binding 'NetworkCFunctions'
      analysis_c_functions = binding 'LoadFlowCFunctions, SecurityAnalysisCFunctions, SensitivityAnalysisCFunctions'
      network_event_recorder_c_functions = binding 'NetworkEventRecorderCFunctions'
      network_event_recording = component 'NetworkEventRecording' 'Attaches a NetworkEventRecorder to the Network, snapshots events, maps string options to export options.'
      rdf_db_c_functions = binding 'RdfDbCFunctions' 'createRdfDbConnection, loadCgmesToRdfDb, loadNetworkFromRdfDb, updateNetworkFromRdfDb, exportNetworkEventsToRdfDb, createRdfDbCheckpoint, getNetworkRdfDbIdentity and the five catalogue entry points. Each carries the scenario, a version and a timestep. An update answers with the handle of an outcome, read back through getRdfDbUpdateInfo and, on the full route only, getRdfDbUpdateNetwork. The variant half adds three: loadNetworkVariantsFromRdfDb (three parallel string arrays - variant id, version, timestep - an empty string meaning let the library decide), getNetworkRdfDbVariants and exportNetworkEventsToRdfDbPerVariant; the variant of a single update or a single export travels in the option map that is already there, so no other signature moved.'
      rdf_db_util = component 'RdfDbUtil' 'The JVM-testable half of the RDF database bindings: option map to RdfDatabase, subset names to CgmesSubset, (scenario, version, timestep) strings to a SnapshotRef, update outcomes to routes (noop | diff | full | refused, and update for the legacy profile replacement), and the catalogue records to dataframes. It also owns the variant surface: loadVariants turns the three string arrays into VariantRequests, variantRows turns the bindings, the variants IIDM holds and the refusals of the last operation into one table with a status column, identity answers for one variant by running inside RdfDbProvenance.inVariant, and the two per-variant exports write each variant history after its own snapshot.'
    }
  }

  pypowsybl.python_api -> pypowsybl.python_network 'creates and passes Network handles'
  pypowsybl.python_api -> pypowsybl.pybind_extension 'calls the extension module'
  pypowsybl.python_network -> pypowsybl.pybind_extension 'passes its opaque handle to'
  pypowsybl.pybind_extension -> pypowsybl.native_image_bridge 'calls native-image entry points through'
  pypowsybl.native_image_bridge -> pypowsybl.java_bindings 'forwards calls across the isolate to'

  pypowsybl.python_network -> pypowsybl.python_event_recorder 'creates (event_recorder())'
  pypowsybl.python_event_recorder -> pypowsybl.pybind_extension 'start/stop/export calls'
  pypowsybl.java_bindings.network_event_recorder_c_functions -> pypowsybl.java_bindings.network_event_recording 'delegates to'
  pypowsybl.java_bindings.network_event_recording -> powsybl_core.iidm.variants.network_event_recorder 'records with'
  pypowsybl.java_bindings.network_event_recording -> powsybl_core.cgmes.partial_ssh_export 'exports partial SSH through'
  pypowsybl.java_bindings.network_event_recording -> powsybl_core.cgmes.cgmes_diff_export 'exports difference models through'
  pypowsybl.java_bindings.network_c_functions -> powsybl_core.cgmes.cgmes_diff_import 'update_from_* reaches transparently via CgmesImport.update'

  pypowsybl.python_api -> pypowsybl.python_rdf_database 'opens (connect_rdf_db / connect)'
  pypowsybl.python_rdf_database -> pypowsybl.pybind_extension 'upload, catalogue, load and update calls'
  pypowsybl.python_network -> pypowsybl.python_rdf_database 'update_from_rdf_db(db, scenario, version, timestep)'
  pypowsybl.python_event_recorder -> pypowsybl.python_rdf_database 'to_rdf_updates(db, scenario, version, timestep)'
  pypowsybl.java_bindings.rdf_db_c_functions -> pypowsybl.java_bindings.rdf_db_util 'delegates to'
  pypowsybl.java_bindings.rdf_db_util -> powsybl_core.cgmes.rdfdb.rdf_database_config 'builds from the option map'
  pypowsybl.java_bindings.rdf_db_util -> powsybl_core.cgmes.rdfdb.rdf_db_connection 'opens and uploads CGMES files through'
  pypowsybl.java_bindings.rdf_db_util -> powsybl_core.cgmes.rdfdb.rdf_db_network_loader 'load / update of one snapshot; another scenario is a full reload'
  pypowsybl.java_bindings.rdf_db_util -> powsybl_core.cgmes.rdfdb.snapshot_catalog 'per scenario: resolves labels, putFull / putAsDiff, listings'
  pypowsybl.java_bindings.rdf_db_util -> powsybl_core.cgmes.rdfdb.rdf_db_difference_sink 'RdfDbExport: recorder events become a snapshot of the base scenario'
  pypowsybl.java_bindings.rdf_db_util -> powsybl_core.cgmes.rdfdb.checkpoint 'checkpoint()'
  pypowsybl.java_bindings.rdf_db_util -> powsybl_core.cgmes.rdfdb.variant_updater 'loadVariants(scenario, requests) and update(..., targetVariant): a day as variants, or one variant moved'
  pypowsybl.java_bindings.rdf_db_util -> powsybl_core.cgmes.rdfdb.variant_binding 'variantRows(network): what every variant stands for, plus the refusals of the last operation'
  pypowsybl.java_bindings.rdf_db_util -> powsybl_core.cgmes.rdfdb.variant_scope 'identity(network, db, scenario, variant) and the per-variant exports run inside RdfDbProvenance.inVariant'
  pypowsybl.java_bindings.network_event_recording -> powsybl_core.cgmes.rdfdb.variant_scope 'the variant option of to_ssh / to_cgmes_diff(s) selects the state and the identity through RdfDbProvenance.inVariant'
  pypowsybl.python_network -> pypowsybl.python_rdf_database 'from_rdf_db(timesteps=[...] | variants={...}) and update_from_rdf_db(..., variant=): snapshots as network variants'
}