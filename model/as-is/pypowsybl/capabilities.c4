model {
  pypowsybl_capability_bundle = module 'pypowsybl: capability families' {
    link https://powsybl.readthedocs.io/projects/pypowsybl/en/stable/user_guide/index.html
    network_and_steady_state = api 'Network and steady-state analysis' 'IIDM creation, formats, extensions, load flow, security analysis, and sensitivity analysis.' {
      link https://powsybl.readthedocs.io/projects/pypowsybl/en/stable/user_guide/network.html
    }
    optimization_and_reac = api 'Optimization and remedial action' 'The Python AC/ACDC OPF prototype and bindings to Open REAC services.' {
      link https://powsybl.readthedocs.io/projects/pypowsybl/en/stable/user_guide/opf.html
    }
    operational_studies = api 'Operational studies' 'RAO and CRAC, short circuit, flow decomposition, and GLSK operations.' {
      link https://powsybl.readthedocs.io/projects/pypowsybl/en/stable/user_guide/rao.html
    }
    dynamic_and_visualization = api 'Dynamic simulation and visualization' 'Dynawo/Dynaflow workflows and single-line/network-area diagrams.' {
      link https://powsybl.readthedocs.io/projects/pypowsybl/en/stable/user_guide/dynamic.html
    }
  }

  pypowsybl_bundled_services = module 'pypowsybl: bundled service families' {
    link https://powsybl.readthedocs.io/projects/pypowsybl/en/stable/index.html
    core_iidm_and_formats = component 'Core IIDM, formats, and CGMES' 'IIDM API/implementation, conversion, serde, format providers, and topology tools.' {
      link https://powsybl.readthedocs.io/projects/powsybl-core/en/latest/grid_model/index.html
    }
    open_loadflow_services = provider 'Open Load Flow providers' 'Load flow, security analysis, and sensitivity analysis providers.' {
      link https://powsybl.readthedocs.io/projects/powsybl-open-loadflow/en/latest/index.html
    }
    optimization_and_reac_services = provider 'Optimization and Open REAC' 'Open REAC services plus PyOptInterface and native solver backends used by the Python OPF prototype.' {
      link https://powsybl.readthedocs.io/projects/pypowsybl/en/stable/user_guide/opf.html
    }
    operational_study_services = provider 'RAO, CRAC, short circuit, and flow decomposition' 'Open RAO/CRAC readers, writers, monitoring, short-circuit providers, flow decomposition, and UCTE GLSK support.' {
      link https://powsybl.readthedocs.io/projects/pypowsybl/en/stable/user_guide/rao.html
    }
    dynamic_and_diagram_services = provider 'Dynawo, Dynaflow, SLD, and NAD' 'Dynamic simulation, dynamic security analysis, single-line diagrams, and network-area diagrams.' {
      link https://powsybl.readthedocs.io/projects/pypowsybl/en/stable/user_guide/network_visualization.html
    }
  }

  pypowsybl.native_image_bridge -> pypowsybl_bundled_services.core_iidm_and_formats 'loads'
  pypowsybl.native_image_bridge -> pypowsybl_bundled_services.open_loadflow_services 'loads'
  pypowsybl.native_image_bridge -> pypowsybl_bundled_services.optimization_and_reac_services 'loads'
  pypowsybl.native_image_bridge -> pypowsybl_bundled_services.operational_study_services 'loads'
  pypowsybl.native_image_bridge -> pypowsybl_bundled_services.dynamic_and_diagram_services 'loads'

  pypowsybl_capability_bundle.network_and_steady_state -> pypowsybl_bundled_services.core_iidm_and_formats 'maps DataFrames and handles to'
  pypowsybl_capability_bundle.network_and_steady_state -> pypowsybl_bundled_services.open_loadflow_services 'selects through Core APIs'
  pypowsybl_capability_bundle.optimization_and_reac -> pypowsybl_bundled_services.optimization_and_reac_services 'maps to'
  pypowsybl_capability_bundle.operational_studies -> pypowsybl_bundled_services.operational_study_services 'maps to'
  pypowsybl_capability_bundle.dynamic_and_visualization -> pypowsybl_bundled_services.dynamic_and_diagram_services 'maps to'
}