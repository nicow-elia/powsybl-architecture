model {
  extend powsybl_open_loadflow {
    open_loadflow_provider = provider 'OpenLoadFlowProvider' 'Implements LoadFlowProvider for AC and DC load flows.' {
      link https://javadoc.io/doc/com.powsybl/powsybl-open-loadflow/latest/com/powsybl/openloadflow/OpenLoadFlowProvider.html
    }
    open_sensitivity_provider = provider 'OpenSensitivityAnalysisProvider' 'Implements SensitivityAnalysisProvider.' {
      link https://javadoc.io/doc/com.powsybl/powsybl-open-loadflow/latest/com/powsybl/openloadflow/sensi/OpenSensitivityAnalysisProvider.html
    }
    open_security_provider = provider 'OpenSecurityAnalysisProvider' 'Implements SecurityAnalysisProvider.' {
      link https://javadoc.io/doc/com.powsybl/powsybl-open-loadflow/latest/com/powsybl/openloadflow/sa/OpenSecurityAnalysisProvider.html
    }
  }

  powsybl_open_loadflow.open_loadflow_provider -> powsybl_open_loadflow.ac_dc_loadflow_engines 'runs AC or DC calculation'
  powsybl_open_loadflow.open_loadflow_provider -> powsybl_open_loadflow.lf_network_adapter 'loads the computation network'
  powsybl_open_loadflow.open_sensitivity_provider -> powsybl_open_loadflow.sensitivity_engines 'runs sensitivity calculation'
  powsybl_open_loadflow.open_sensitivity_provider -> powsybl_open_loadflow.open_loadflow_provider 'uses the configured base-case load-flow provider'
  powsybl_open_loadflow.open_security_provider -> powsybl_open_loadflow.security_analysis_engines 'runs pre/post-contingency simulations'
}