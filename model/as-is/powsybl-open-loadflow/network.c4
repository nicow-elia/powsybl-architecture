model {
  extend powsybl_open_loadflow {
    lf_network_adapter = adapter 'IIDM to LfNetwork adapter' 'Networks, LfNetworkLoaderImpl, and equipment-specific Lf* adapters.' {
      link https://powsybl.readthedocs.io/projects/powsybl-open-loadflow/en/latest/advanced_programming/lfnetwork_loader_postprocessor.html
      network_loader = component 'Networks and LfNetworkLoader' 'Builds the solver-facing topology and reconnectable elements from IIDM.' {
        link https://powsybl.readthedocs.io/projects/powsybl-open-loadflow/en/latest/advanced_programming/lfnetwork_loader_postprocessor.html
      }
    }
    lf_network = model 'LfNetwork' 'Solver-facing electrical network, topology, equations, and state.' {
      link https://javadoc.io/doc/com.powsybl/powsybl-open-loadflow/latest/com/powsybl/openloadflow/network/LfNetwork.html
    }
    contingency_propagation = adapter 'Contingency propagation' 'PropagatedContingency, ContingencyTripping, and node/breaker traversal.' {
      link https://powsybl.readthedocs.io/projects/powsybl-open-loadflow/en/latest/security/inputs.html
    }
    state_and_result_mapping = adapter 'IIDM state and core-result mapping' 'Updates IIDM state and adapts solver outputs to Core result contracts.' {
      link https://powsybl.readthedocs.io/projects/powsybl-open-loadflow/en/latest/loadflow/loadflow.html
    }
  }

  powsybl_open_loadflow.lf_network_adapter -> powsybl_open_loadflow.lf_network 'builds and configures'
  powsybl_open_loadflow.lf_network_adapter.network_loader -> powsybl_open_loadflow.lf_network 'builds and configures'
  powsybl_open_loadflow.lf_network -> powsybl_open_loadflow.equation_toolkit 'supplies variables and network state to'
  powsybl_open_loadflow.contingency_propagation -> powsybl_open_loadflow.lf_network 'produces LfContingency operations for'
}