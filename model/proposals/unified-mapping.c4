// Proposal: one IIDM <-> CGMES mapping for every steady state hypothesis path (powsybl-core branch
// feat/diffstacking-unified-mapping, design B "family classes"). The "before" elements stand for code of the
// diffstacking branch at the start of the rework (bb9cb0eb85); the others exist on the branch at p4-merged (20ce552c50)
// and are not upstream. Figures: architecture-evidence.md, "Unified mapping proposal".
model {
  proposed_unified_mapping = module 'Unified mapping (proposal)' 'One statement per rule: families describe a CGMES object for every export, read the values the importer sets, and answer the in-place import of a difference.' {

    // Before: every path carries its own knowledge of the mapping
    before_ssh_writers = component 'SteadyStateHypothesisExport writers (before)' 'The full SSH export wrote every value with code of its own: generator sign, regulating terminal sign, unit multiplier, regulating controls. 13 statements of EnergyConsumer.p and 19 of the generator sign over the branch, 4 and 5 of them here.'
    before_probes = component 'DiffProbes + DiffSubjectResolver + CgmesLimitIndex (before)' 'The in-place import probed the network with property lists of its own to complete a group and to check reverse values, next to the hand-written FastRouteCapabilities table.'

    // After
    families = component 'Family classes (8)' 'SwitchAndTerminal, Load, Machine, TapChangerAndShunt, RegulatingControl, Hvdc, ControlArea, Limit. Each declares the keys a change is dispatched by and the blocks the CGMES update reads; describe* writes an object to a sink, *Updates asks the refusals of a change first.' {
      load_family = component 'LoadFamily' 'EnergyConsumer, EnergySource, AsynchronousMachine and the fictitious injections, as plain rows.'
      machine_family = component 'MachineFamily' 'SynchronousMachine, ExternalNetworkInjection, EquivalentInjection, GeneratingUnit: describeSynchronousMachine writes RotatingMachine.p = -targetP.'
      tap_changer_and_shunt_family = component 'TapChangerAndShuntFamily' 'Tap changers, shunt compensators and static var compensators.'
      switch_and_terminal_family = component 'SwitchAndTerminalFamily' 'Switch.open and Terminal.connected (AC and DC).'
      hvdc_family = component 'HvdcFamily' 'Converters and their control modes and targets.'
      limit_family = component 'LimitFamily' 'Operational and voltage level limits, line impedances (EQ statements).'
      regulating_control_family = component 'RegulatingControlFamily' 'RegulatingControl and TapChangerControl, shared ones combined.'
      control_area_family = component 'ControlAreaFamily' 'ControlArea net interchange and tolerance, as plain rows.'
    }
    plain_rows = model 'PlainFamily / PlainRow / Quantity / Block' 'A plain family is data: a CGMES property, the IIDM attribute and the quantity (unit multiplier, sign, sign of the regulating terminal, spelling) once for both directions. The loads are plain families.'
    property_sink = api 'CgmesPropertySink' 'Where a family writes: the document of the full export, or the buffer of one change.'
    refusal = model 'Refusal' 'Rule, remedy and scope of every refusal: a receiver of changes honours it, a full model states the whole state.'
    subject_index = component 'Families (subject index + describe)' 'Which network object a CGMES identifier names and what the network says about it, from the aliases and properties the families read.'
    fast_route_plan = component 'FastRoutePlan' 'The decision and the plan of one in-place import: resolves every subject through Families.resolve, checks it against the block of its family, completes groups with describe.'
    mapping_page = format 'mapping.md (generated)' 'The documentation page of the mapping: generated by MappingPageTest from the families, the plain rows, FastRouteCapabilities and Refusal; the test fails when it is stale.'
  }

  // Before
  powsybl_core.iidm.io.export_providers.cgmes_exporter -> proposed_unified_mapping.before_ssh_writers 'writes the full SSH with (own rules)'
  proposed_unified_mapping.before_ssh_writers -> powsybl_core.iidm.network 'reads'
  powsybl_core.cgmes.cgmes_diff_import -> proposed_unified_mapping.before_probes 'completes groups with (own property lists)'
  proposed_unified_mapping.before_probes -> powsybl_core.cgmes.cgmes_object_dump 'asks'

  // After
  powsybl_core.iidm.io.export_providers.cgmes_exporter -> proposed_unified_mapping.families 'writes the full SSH through'
  powsybl_core.cgmes.change_translator -> proposed_unified_mapping.families 'dispatches a change by key to'
  proposed_unified_mapping.families -> proposed_unified_mapping.plain_rows 'states plain values as'
  proposed_unified_mapping.families -> proposed_unified_mapping.property_sink 'describes objects into'
  proposed_unified_mapping.families -> proposed_unified_mapping.refusal 'refuses with'
  proposed_unified_mapping.families -> powsybl_core.iidm.network 'reads the current or previous state of'
  proposed_unified_mapping.property_sink -> powsybl_core.cgmes.difference_model 'becomes statements of'
  proposed_unified_mapping.property_sink -> powsybl_core.iidm.io.exchange_formats.cgmes 'becomes the SSH document of'
  powsybl_core.cgmes.cgmes_diff_import -> proposed_unified_mapping.subject_index 'resolves subjects and completes groups with'
  proposed_unified_mapping.subject_index -> proposed_unified_mapping.families 'describes a subject with'
  powsybl_core.cgmes.fast_route_capabilities -> proposed_unified_mapping.families 'derives its table from the blocks of'
  powsybl_core.cgmes.conversion_update -> proposed_unified_mapping.plain_rows 'sets loads, control areas and switches through'
  proposed_unified_mapping.mapping_page -> proposed_unified_mapping.families 'is generated from'
  proposed_unified_mapping.mapping_page -> proposed_unified_mapping.refusal 'lists rule, scope and remedy of'

  // After, at the level of single classes (rework-end, 8d6fc2e860)
  powsybl_core.cgmes.ssh_export -> proposed_unified_mapping.families 'describes every object through'
  proposed_unified_mapping.property_sink -> powsybl_core.cgmes.ssh_export 'full model: CgmesPropertySink.Xml writes the document of'
  proposed_unified_mapping.property_sink -> powsybl_core.cgmes.partial_ssh_export 'one change: CgmesPropertyBuffer, written by'
  proposed_unified_mapping.property_sink -> powsybl_core.cgmes.cgmes_diff_export 'one change: CgmesPropertyBuffer, compared by'
  powsybl_core.cgmes.cgmes_diff_import -> proposed_unified_mapping.fast_route_plan 'plans the in-place import with'
  proposed_unified_mapping.fast_route_plan -> proposed_unified_mapping.subject_index 'resolves subjects with'
  proposed_unified_mapping.fast_route_plan -> proposed_unified_mapping.families 'checks and completes the blocks of'
  powsybl_core.cgmes.element_conversions -> proposed_unified_mapping.plain_rows 'reads loads, control areas and switches through'
}

// Legend elements of the unified mapping views: they stand for no code.
model {
  unified_mapping_legend = module 'Legend' {
    rule_stated = component 'Rule stated here' 'Code that writes RotatingMachine.p = -targetP itself'
    unchanged = component 'Upstream code, unchanged' 'Exists on upstream main as it is'
    reworked = component 'New or reworked by the proposal' 'Branch feat/diffstacking-unified-mapping, rework-end'
  }
}
