// Proposed State Estimation target structures. All proposal_* elements are
// future-state alternatives; existing code is referenced through canonical
// powsybl_core, powsybl_open_loadflow, and pypowsybl FQNs.
model {
  proposal_a_open_steady_state = repository 'Proposed powsybl-open-steady-state' 'Target repository created by extracting reusable network and equation toolkits from the current Open Load Flow codebase.' {
    summary 'Reusable topology, equation, derivative, and matrix toolbox.'
    proposal_a_network_toolkit = module 'Network toolkit' 'LfNetwork, LfNetworkLoader, GraphConnectivity, AdmittanceMatrix, and target topology-projection support.' {
      proposal_a_topology_measurement_projection = component 'Node/breaker-to-bus/branch measurement projection' 'Applies switch and breaker status, reduces topology, and maps measurement locations to bus-voltage state variables.'
    }
    proposal_a_equation_toolkit = module 'Equation toolkit' 'EquationSystem, Evaluable, Derivable, JacobianMatrix, state variables, and reusable AC flow terms.' {
      proposal_a_measurement_equation_builder = component 'State Estimation measurement-equation builder' 'Builds h(x) and differentiates it into H against the indexed bus-voltage state vector.'
    }
  }
  proposal_a_open_loadflow = repository 'Proposed powsybl-open-loadflow' 'Target post-extraction repository retaining load-flow engines and providers.' {
    proposal_a_loadflow = module 'open-loadflow' 'AC/DC load-flow engines, OpenLoadFlowProvider, solver selection, outer loops, and result mapping retained after the toolkit extraction.'
  }
  proposal_a_state_estimation = repository 'Proposed powsybl-state-estimation' 'Target standalone repository for the new estimator implementation.' {
    proposal_a_state_estimation_module = module 'state-estimation' 'Standalone StateEstimationProvider, WLS, observability, diagnostics, and result mapping.' {
      proposal_a_state_estimation_provider = provider 'StateEstimationProvider' 'ServiceLoader implementation that coordinates the public State Estimation API.'
      proposal_a_measurement_preparation = component 'Measurement and covariance preparation' 'Normalizes projected bus/branch measurements, standard deviations, statuses, z, R, and W = R^-1.'
      proposal_a_observability_analysis = component 'Observability analysis' 'Uses projected bus/branch measurement incidence to partition connected components and select observable bus-voltage states.'
      proposal_a_wls_kernel = module 'WLS kernel' 'Iterative weighted least-squares estimator.' {
        proposal_a_state_vector = model 'State vector x' 'Initial and updated bus-voltage magnitude and phase-angle estimate, indexed after topology projection and observability analysis.'
        proposal_a_measurement_function = component 'Measurement function h(x) and residual r' 'Uses equation-toolkit terms to evaluate h(x) on the projected bus/branch network and computes r = z - h(x).'
        proposal_a_measurement_jacobian = component 'Measurement Jacobian H' 'Uses the equation toolkit to differentiate h(x) against the indexed state vector.'
        proposal_a_normal_equations = component 'Normal-equation assembly' 'Builds G = H^T W H and b = H^T W r, then prepares G delta x = b.'
        proposal_a_gauss_newton_solver = engine 'Gauss-Newton WLS solver' 'Solves weighted corrections until convergence.'
      }
      proposal_a_bad_data_diagnostics = component 'Post-convergence residual and bad-data diagnostics' 'Uses residuals, H, weights, and retained factors to compute chi-square, residual-covariance, normalized-residual, and bad-data diagnostics after convergence.'
      proposal_a_result_mapping = adapter 'State-estimation result mapping' 'Maps estimated bus/branch state and diagnostics back to IIDM-facing StateEstimationResult and StateEstimationReport.'
    }
  }

  proposal_b_open_simulator = repository 'Proposed powsybl-open-simulator' 'powsybl-open-loadflow renamed powsybl-open-simulator and restructured as a multi-module Maven project, as proposed in powsybl-open-loadflow issue #417, with new State Estimation and grid-reduction modules.' {
    link https://github.com/powsybl/powsybl-open-loadflow/issues/417
    proposal_b_matrix = module 'powsybl-open-simulator-matrix' 'Transfer of com.powsybl.math.matrix from powsybl-core: Matrix, MatrixFactory, dense and sparse matrices, and LU decompositions.'
    proposal_b_network = module 'powsybl-open-simulator-network' 'Would contain com.powsybl.openloadflow.network, with LfNetwork renamed OsNetwork.' {
      proposal_b_topology_measurement_projection = component 'Node/breaker-to-bus/branch measurement projection' 'Applies switch and breaker status, reduces topology, and maps measurement locations to bus-voltage state variables.'
    }
    proposal_b_core = module 'powsybl-open-simulator-core' 'Would contain com.powsybl.openloadflow.equations: EquationSystem, EquationTerm, VariableSet, StateVector, TargetVector, and JacobianMatrix.' {
      proposal_b_measurement_equation_builder = component 'State Estimation measurement-equation builder' 'Builds h(x) and differentiates it into H against the indexed bus-voltage state vector.'
    }
    proposal_b_loadflow = module 'powsybl-open-loadflow' 'Remaining code from the current repository: load flow (lf), security analysis (sa), and sensitivity analysis (sensi) in AC and DC, including the AC and DC equation terms.'
    proposal_b_state_estimation = module 'powsybl-open-state-estimation' 'New module: StateEstimationProvider, WLS estimation, observability analysis, bad-data diagnostics, and result mapping.' {
      proposal_b_state_estimation_provider = provider 'StateEstimationProvider' 'ServiceLoader implementation that coordinates the public State Estimation API.'
      proposal_b_measurement_preparation = component 'Measurement and covariance preparation' 'Normalizes projected bus/branch measurements, standard deviations, statuses, z, R, and W = R^-1.'
      proposal_b_observability_analysis = component 'Observability analysis' 'Uses projected bus/branch measurement incidence to partition connected components and select observable bus-voltage states.'
      proposal_b_wls_kernel = module 'WLS kernel' 'Iterative weighted least-squares estimator.' {
        proposal_b_state_vector = model 'State vector x' 'Initial and updated bus-voltage magnitude and phase-angle estimate, indexed after topology projection and observability analysis.'
        proposal_b_measurement_function = component 'Measurement function h(x) and residual r' 'Uses equation-toolkit terms to evaluate h(x) on the projected bus/branch network and computes r = z - h(x).'
        proposal_b_measurement_jacobian = component 'Measurement Jacobian H' 'Uses the equation toolkit to differentiate h(x) against the indexed state vector.'
        proposal_b_normal_equations = component 'Normal-equation assembly' 'Builds G = H^T W H and b = H^T W r, then prepares G delta x = b.'
        proposal_b_gauss_newton_solver = engine 'Gauss-Newton WLS solver' 'Solves weighted corrections until convergence.'
      }
      proposal_b_bad_data_diagnostics = component 'Post-convergence residual and bad-data diagnostics' 'Uses residuals, H, weights, and retained factors to compute chi-square, residual-covariance, normalized-residual, and bad-data diagnostics after convergence.'
      proposal_b_result_mapping = adapter 'State-estimation result mapping' 'Maps estimated bus/branch state and diagnostics back to IIDM-facing StateEstimationResult and StateEstimationReport.'
    }
    proposal_b_grid_reduction = module 'powsybl-open-grid-reduction' 'New grid-reduction module.'
  }

  powsybl_open_loadflow.lf_network -> proposal_a_open_steady_state.proposal_a_network_toolkit 'would be extracted into'
  powsybl_open_loadflow.lf_network_adapter.network_loader -> proposal_a_open_steady_state.proposal_a_network_toolkit 'would move with'
  powsybl_open_loadflow.equation_toolkit -> proposal_a_open_steady_state.proposal_a_equation_toolkit 'would be extracted into'
  powsybl_open_loadflow.open_loadflow_provider -> proposal_a_open_loadflow.proposal_a_loadflow 'would remain in'
  powsybl_open_loadflow.ac_dc_loadflow_engines -> proposal_a_open_loadflow.proposal_a_loadflow 'would remain in'
  proposal_a_open_steady_state.proposal_a_network_toolkit -> proposal_a_open_steady_state.proposal_a_equation_toolkit 'would supply topology and admittance to'
  proposal_a_open_steady_state.proposal_a_equation_toolkit -> proposed_rectangular_measurement_jacobian 'would expose support for'
  proposal_a_open_steady_state.proposal_a_equation_toolkit -> proposed_reusable_ac_measurement_terms 'would publish through'
  proposal_a_open_steady_state.proposal_a_network_toolkit.proposal_a_topology_measurement_projection -> proposed_bus_branch_measurement_projection 'would implement'
  proposal_a_open_loadflow.proposal_a_loadflow -> proposal_a_open_steady_state.proposal_a_network_toolkit 'would use the target network toolkit'
  proposal_a_open_loadflow.proposal_a_loadflow -> proposal_a_open_steady_state.proposal_a_equation_toolkit 'would use the target equation toolkit'
  proposed_state_estimation_core_api -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_state_estimation_provider 'would discover through ServiceLoader'
  proposed_state_estimation_input_contract -> proposal_a_state_estimation.proposal_a_state_estimation_module 'would define inputs and results for'
  proposed_state_estimation_input_contract -> proposal_a_open_steady_state.proposal_a_network_toolkit.proposal_a_topology_measurement_projection 'would provide IIDM topology, switch status, and measurement metadata to'
  proposal_a_state_estimation.proposal_a_state_estimation_module -> proposal_a_open_steady_state.proposal_a_network_toolkit 'would use the target network toolkit'
  proposal_a_state_estimation.proposal_a_state_estimation_module -> proposal_a_open_steady_state.proposal_a_equation_toolkit 'would use the target equation toolkit'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_state_estimation_provider -> proposal_a_open_steady_state.proposal_a_network_toolkit.proposal_a_topology_measurement_projection 'would start topology and measurement projection through'
  proposal_a_open_steady_state.proposal_a_network_toolkit.proposal_a_topology_measurement_projection -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_measurement_preparation 'would provide projected measurement locations to'
  proposal_a_open_steady_state.proposal_a_network_toolkit.proposal_a_topology_measurement_projection -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_observability_analysis 'would provide reduced topology and measurement-to-state incidence to'
  proposal_a_open_steady_state.proposal_a_network_toolkit.proposal_a_topology_measurement_projection -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_state_vector 'would initialize and index'
  proposal_a_open_steady_state.proposal_a_network_toolkit.proposal_a_topology_measurement_projection -> proposal_a_open_steady_state.proposal_a_equation_toolkit.proposal_a_measurement_equation_builder 'would provide reduced topology and measurement mappings to'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_measurement_preparation -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_observability_analysis 'would provide usable measurement statuses to'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_measurement_preparation -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_measurement_function 'would provide z and measurement descriptors to'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_measurement_preparation -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_normal_equations 'would provide R and W to'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_observability_analysis -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_state_vector 'selects observable variables for'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_state_vector -> proposal_a_open_steady_state.proposal_a_equation_toolkit.proposal_a_measurement_equation_builder 'would supply indexed variables to'
  proposal_a_open_steady_state.proposal_a_equation_toolkit.proposal_a_measurement_equation_builder -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_measurement_function 'would build h(x) for'
  proposal_a_open_steady_state.proposal_a_equation_toolkit.proposal_a_measurement_equation_builder -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_measurement_jacobian 'would differentiate h(x) to build'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_state_vector -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_measurement_function 'would be evaluated by'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_state_vector -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_measurement_jacobian 'would index columns for'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_measurement_function -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_normal_equations 'supplies residuals to'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_measurement_jacobian -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_normal_equations 'supplies derivatives to'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_normal_equations -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_gauss_newton_solver 'solves weighted corrections with'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_gauss_newton_solver -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_state_vector 'updates'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_measurement_function -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_bad_data_diagnostics 'would provide residuals to'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_measurement_jacobian -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_bad_data_diagnostics 'would provide H to'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_normal_equations -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_bad_data_diagnostics 'would provide weighted-system factors to'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_gauss_newton_solver -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_bad_data_diagnostics 'would trigger post-convergence processing in'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_bad_data_diagnostics -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_result_mapping 'adds diagnostics to'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_state_vector -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_result_mapping 'provides estimated state to'
  proposal_a_open_steady_state.proposal_a_network_toolkit.proposal_a_topology_measurement_projection -> proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_result_mapping 'would map bus/branch estimates back to IIDM elements through'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_normal_equations -> proposed_rectangular_measurement_jacobian 'would require'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_wls_kernel.proposal_a_normal_equations -> proposed_retained_factorization 'would require'
  proposal_a_state_estimation.proposal_a_state_estimation_module.proposal_a_result_mapping -> proposed_state_estimation_core_api 'would return results through'

  // Proposal B refactoring (powsybl-open-loadflow issue #417): where current code would move.
  powsybl_core.math -> proposal_b_open_simulator.proposal_b_matrix 'com.powsybl.math.matrix would transfer into'
  powsybl_open_loadflow.lf_network -> proposal_b_open_simulator.proposal_b_network 'would move, renamed OsNetwork, into'
  powsybl_open_loadflow.lf_network_adapter -> proposal_b_open_simulator.proposal_b_network 'would move into'
  powsybl_open_loadflow.contingency_propagation -> proposal_b_open_simulator.proposal_b_network 'would move into'
  powsybl_open_loadflow.equation_toolkit.equation_system -> proposal_b_open_simulator.proposal_b_core 'would move into'
  powsybl_open_loadflow -> proposal_b_open_simulator.proposal_b_loadflow 'remaining lf, sa, sensi, AC, and DC code would stay in'

  // Proposal B module layering; transitive dependencies are implied.
  proposal_b_open_simulator.proposal_b_network -> proposal_b_open_simulator.proposal_b_matrix 'would depend on'
  proposal_b_open_simulator.proposal_b_core -> proposal_b_open_simulator.proposal_b_network 'would depend on'
  proposal_b_open_simulator.proposal_b_loadflow -> proposal_b_open_simulator.proposal_b_core 'would depend on'
  proposal_b_open_simulator.proposal_b_state_estimation -> proposal_b_open_simulator.proposal_b_core 'would depend on'
  proposal_b_open_simulator.proposal_b_grid_reduction -> proposal_b_open_simulator.proposal_b_core 'would depend on'

  proposal_b_open_simulator.proposal_b_core -> proposed_rectangular_measurement_jacobian 'would expose support for'
  proposal_b_open_simulator.proposal_b_core -> proposed_reusable_ac_measurement_terms 'would publish through'
  proposal_b_open_simulator.proposal_b_network.proposal_b_topology_measurement_projection -> proposed_bus_branch_measurement_projection 'would implement'
  proposed_state_estimation_core_api -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_state_estimation_provider 'would discover through ServiceLoader'
  proposed_state_estimation_input_contract -> proposal_b_open_simulator.proposal_b_state_estimation 'would define inputs and results for'
  proposed_state_estimation_input_contract -> proposal_b_open_simulator.proposal_b_network.proposal_b_topology_measurement_projection 'would provide IIDM topology, switch status, and measurement metadata to'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_state_estimation_provider -> proposal_b_open_simulator.proposal_b_network.proposal_b_topology_measurement_projection 'would start topology and measurement projection through'
  proposal_b_open_simulator.proposal_b_network.proposal_b_topology_measurement_projection -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_measurement_preparation 'would provide projected measurement locations to'
  proposal_b_open_simulator.proposal_b_network.proposal_b_topology_measurement_projection -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_observability_analysis 'would provide reduced topology and measurement-to-state incidence to'
  proposal_b_open_simulator.proposal_b_network.proposal_b_topology_measurement_projection -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_state_vector 'would initialize and index'
  proposal_b_open_simulator.proposal_b_network.proposal_b_topology_measurement_projection -> proposal_b_open_simulator.proposal_b_core.proposal_b_measurement_equation_builder 'would provide reduced topology and measurement mappings to'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_measurement_preparation -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_observability_analysis 'would provide usable measurement statuses to'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_measurement_preparation -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_measurement_function 'would provide z and measurement descriptors to'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_measurement_preparation -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_normal_equations 'would provide R and W to'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_observability_analysis -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_state_vector 'selects observable variables for'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_state_vector -> proposal_b_open_simulator.proposal_b_core.proposal_b_measurement_equation_builder 'would supply indexed variables to'
  proposal_b_open_simulator.proposal_b_core.proposal_b_measurement_equation_builder -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_measurement_function 'would build h(x) for'
  proposal_b_open_simulator.proposal_b_core.proposal_b_measurement_equation_builder -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_measurement_jacobian 'would differentiate h(x) to build'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_state_vector -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_measurement_function 'would be evaluated by'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_state_vector -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_measurement_jacobian 'would index columns for'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_measurement_function -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_normal_equations 'supplies residuals to'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_measurement_jacobian -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_normal_equations 'supplies derivatives to'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_normal_equations -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_gauss_newton_solver 'solves weighted corrections with'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_gauss_newton_solver -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_state_vector 'updates'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_measurement_function -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_bad_data_diagnostics 'would provide residuals to'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_measurement_jacobian -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_bad_data_diagnostics 'would provide H to'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_normal_equations -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_bad_data_diagnostics 'would provide weighted-system factors to'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_gauss_newton_solver -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_bad_data_diagnostics 'would trigger post-convergence processing in'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_bad_data_diagnostics -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_result_mapping 'adds diagnostics to'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_state_vector -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_result_mapping 'provides estimated state to'
  proposal_b_open_simulator.proposal_b_network.proposal_b_topology_measurement_projection -> proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_result_mapping 'would map bus/branch estimates back to IIDM elements through'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_normal_equations -> proposed_rectangular_measurement_jacobian 'would require'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_wls_kernel.proposal_b_normal_equations -> proposed_retained_factorization 'would require'
  proposal_b_open_simulator.proposal_b_state_estimation.proposal_b_result_mapping -> proposed_state_estimation_core_api 'would return results through'
}