views {
  view index of powsybl_core {
    title 'powsybl-core: Repository structure'
    description 'powsybl-core provides the IIDM network model, public computation APIs, shared contingency contracts, and common runtime services. Select IIDM to inspect its equipment model and supported exchange formats.'

    include *

    style iidm {
      color indigo
    }
  }
}