specification {
  element repository
  element module
  element api
  element provider
  element engine
  element adapter
  element model
  element component
  element binding
  element library
  element format
}

model {
  powsybl_core = repository 'powsybl-core' 'IIDM network model, analysis APIs, shared contracts, and provider discovery.' {
    iidm = module 'IIDM API and extensions' 'The mutable electrical-network object model, its principal interfaces, extensions, and format providers.' {
      network = model 'Network' 'IIDM Network and working variant passed by reference to every analysis.'

      common_types = module 'Common IIDM contracts' 'Base interfaces shared by the network model.' {
        identifiable = component 'Identifiable' 'Base contract for named IIDM objects.'
        connectable = component 'Connectable' 'Base contract for equipment that owns terminals.'
        terminal = component 'Terminal' 'Electrical connection point between equipment and voltage-level topology.'
      }

      variants = module 'Network lifecycle' 'Network creation, variants, and mutation notifications.' {
        network_factory = component 'NetworkFactory' 'Creates an IIDM Network implementation.'
        variant_manager = component 'VariantManager' 'Selects and manages the working variant.'
        network_listener = component 'NetworkListener' 'Receives IIDM network changes.'

        network_factory -> network 'creates'
        variant_manager -> network 'selects a working variant on'
        network_listener -> network 'observes changes on'
      }

      topology = module 'Topology and containment' 'The AC network hierarchy and its bus/breaker or node/breaker topology.' {
        substation = component 'Substation' 'Contains voltage levels and their equipment.'
        voltage_level = component 'VoltageLevel' 'Owns bus/breaker and node/breaker topology.'
        bus = component 'Bus' 'Electrical node in the bus topology.'
        busbar_section = component 'BusbarSection' 'Physical busbar element in node/breaker topology.'
        switch = component 'Switch' 'Coupler, disconnector, or breaker that changes topology.'
        topology_views = component 'VoltageLevel topology views' 'Bus, bus/breaker, and node/breaker views expose the resolved topology.'
        area = component 'Area and AreaBoundary' 'Groups equipment for operational and geographical purposes.'

        substation -> voltage_level 'contains'
        voltage_level -> bus 'contains bus topology'
        voltage_level -> busbar_section 'contains node/breaker equipment'
        voltage_level -> switch 'contains switching equipment'
        voltage_level -> topology_views 'exposes through'
      }

      injections = module 'Injections' 'Connectable equipment that produces, consumes, or compensates power.' {
        generator = component 'Generator'
        load = component 'Load' 'Includes ZIP and exponential load models.'
        battery = component 'Battery'
        shunt_compensator = component 'ShuntCompensator' 'Linear or non-linear shunt model.'
        static_var_compensator = component 'StaticVarCompensator'
        ground = component 'Ground'
      }

      branches = module 'AC branches' 'Connectable equipment joining two AC terminals.' {
        branch = component 'Branch' 'Base branch contract.'
        ac_line = component 'Line'
        tie_line = component 'TieLine'
      }

      transformers = module 'Transformers and tap changers' 'AC transformers and their voltage/phase regulation equipment.' {
        two_windings_transformer = component 'TwoWindingsTransformer'
        three_windings_transformer = component 'ThreeWindingsTransformer'
        ratio_tap_changer = component 'RatioTapChanger'
        phase_tap_changer = component 'PhaseTapChanger'

        two_windings_transformer -> ratio_tap_changer 'may own'
        two_windings_transformer -> phase_tap_changer 'may own'
        three_windings_transformer -> ratio_tap_changer 'may own per leg'
        three_windings_transformer -> phase_tap_changer 'may own per leg'
      }

      hvdc = module 'HVDC equipment' 'HVDC line and AC/DC converter-station model.' {
        hvdc_line = component 'HvdcLine'
        vsc_converter_station = component 'VscConverterStation'
        lcc_converter_station = component 'LccConverterStation'

        hvdc_line -> vsc_converter_station 'connects through'
        hvdc_line -> lcc_converter_station 'connects through'
      }

      dc_grid = module 'DC grid equipment' 'The explicit DC network topology model.' {
        dc_bus = component 'DcBus'
        dc_line = component 'DcLine'
        dc_switch = component 'DcSwitch'
      }

      limits_and_control = module 'Limits and automation' 'Operating limits, reactive limits, and automation systems attached to equipment.' {
        operational_limits = component 'OperationalLimits and LoadingLimits'
        reactive_limits = component 'ReactiveLimits'
        automation_system = component 'AutomationSystem and OverloadManagementSystem'
      }

      extensions = module 'IIDM extensions' 'Extension points and common calculated-state extensions.' {
        extension_contract = component 'Extension and Extendable' 'Extension mechanism available on IIDM objects.'
        slack_terminal = component 'SlackTerminal'
        reference_terminals = component 'ReferenceTerminals'
        cgmes_extensions = component 'CGMES extensions' 'CGMES-specific data carried beside the IIDM model.'
      }

      io = module 'IIDM I/O and format providers' 'Network.read and Network.write select registered Importer and Exporter implementations.' {
        network_read_write = api 'Network.read / Network.write' 'Facade methods on Network.'
        importer_spi = api 'Importer and Importers' 'SPI for constructing an IIDM Network from a data source.'
        exporter_spi = api 'Exporter and Exporters' 'SPI for writing an IIDM Network to a data sink.'
        provider_discovery = component 'Importers/Exporters ServiceLoader' 'Discovers @AutoService provider implementations.'

        exchange_formats = module 'Supported exchange formats' {
          cgmes = format 'CGMES'
          ucte = format 'UCTE'
          matpower = format 'MATPOWER'
          psse = format 'PSS/E'
          ieee_cdf = format 'IEEE CDF'
          powerfactory = format 'PowerFactory'
          xiidm = format 'XIIDM XML'
          jiidm = format 'JIIDM JSON'
          biidm = format 'BIIDM binary'
          ampl = format 'AMPL'
        }

        import_providers = module 'Importer implementations' {
          cgmes_importer = adapter 'CgmesImport'
          ucte_importer = adapter 'UcteImporter'
          matpower_importer = adapter 'MatpowerImporter'
          psse_importer = adapter 'PsseImporter'
          ieee_cdf_importer = adapter 'IeeeCdfImporter'
          powerfactory_importer = adapter 'PowerFactoryImporter'
          xiidm_importer = adapter 'XMLImporter'
          jiidm_importer = adapter 'JsonImporter'
          biidm_importer = adapter 'BinaryImporter'
        }

        export_providers = module 'Exporter implementations' {
          cgmes_exporter = adapter 'CgmesExport'
          ucte_exporter = adapter 'UcteExporter'
          matpower_exporter = adapter 'MatpowerExporter'
          psse_exporter = adapter 'PsseExporter'
          xiidm_exporter = adapter 'XMLExporter'
          jiidm_exporter = adapter 'JsonExporter'
          biidm_exporter = adapter 'BinaryExporter'
          ampl_exporter = adapter 'AmplExporter'
        }

        network_read_write -> importer_spi 'selects input provider'
        network_read_write -> exporter_spi 'selects output provider'
        provider_discovery -> importer_spi 'discovers implementations for'
        provider_discovery -> exporter_spi 'discovers implementations for'

        exchange_formats.cgmes -> import_providers.cgmes_importer 'loads'
        exchange_formats.ucte -> import_providers.ucte_importer 'loads'
        exchange_formats.matpower -> import_providers.matpower_importer 'loads'
        exchange_formats.psse -> import_providers.psse_importer 'loads'
        exchange_formats.ieee_cdf -> import_providers.ieee_cdf_importer 'loads'
        exchange_formats.powerfactory -> import_providers.powerfactory_importer 'loads'
        exchange_formats.xiidm -> import_providers.xiidm_importer 'loads'
        exchange_formats.jiidm -> import_providers.jiidm_importer 'loads'
        exchange_formats.biidm -> import_providers.biidm_importer 'loads'

        import_providers.cgmes_importer -> network 'creates or updates'
        import_providers.ucte_importer -> network 'creates or updates'
        import_providers.matpower_importer -> network 'creates or updates'
        import_providers.psse_importer -> network 'creates or updates'
        import_providers.ieee_cdf_importer -> network 'creates or updates'
        import_providers.powerfactory_importer -> network 'creates or updates'
        import_providers.xiidm_importer -> network 'creates or updates'
        import_providers.jiidm_importer -> network 'creates or updates'
        import_providers.biidm_importer -> network 'creates or updates'

        network -> export_providers.cgmes_exporter 'serializes'
        network -> export_providers.ucte_exporter 'serializes'
        network -> export_providers.matpower_exporter 'serializes'
        network -> export_providers.psse_exporter 'serializes'
        network -> export_providers.xiidm_exporter 'serializes'
        network -> export_providers.jiidm_exporter 'serializes'
        network -> export_providers.biidm_exporter 'serializes'
        network -> export_providers.ampl_exporter 'serializes'

        export_providers.cgmes_exporter -> exchange_formats.cgmes 'writes'
        export_providers.ucte_exporter -> exchange_formats.ucte 'writes'
        export_providers.matpower_exporter -> exchange_formats.matpower 'writes'
        export_providers.psse_exporter -> exchange_formats.psse 'writes'
        export_providers.xiidm_exporter -> exchange_formats.xiidm 'writes'
        export_providers.jiidm_exporter -> exchange_formats.jiidm 'writes'
        export_providers.biidm_exporter -> exchange_formats.biidm 'writes'
        export_providers.ampl_exporter -> exchange_formats.ampl 'writes'
      }

      network -> common_types 'is composed of identifiable and connectable objects'
      network -> topology 'owns electrical topology'
      network -> injections 'owns injections'
      network -> branches 'owns AC branches'
      network -> transformers 'owns transformers and tap changers'
      network -> hvdc 'owns DC equipment'
      network -> dc_grid 'owns explicit DC topology'
      network -> limits_and_control 'owns equipment with limits and automation'
      network -> io.network_read_write 'provides facade methods for'
      extensions -> network 'enriches state and results on'
    }

    loadflow_api = api 'Load Flow API' 'LoadFlow.Runner and the LoadFlowProvider SPI.'
    sensitivity_api = api 'Sensitivity Analysis API' 'SensitivityAnalysis.Runner and the SensitivityAnalysisProvider SPI.'
    security_analysis_api = api 'Security Analysis API' 'SecurityAnalysis.Runner and the SecurityAnalysisProvider SPI.'
    contingency_api = api 'Contingency API' 'Contingency, ContingenciesProvider, and contingency elements.'
    commons = library 'Commons services' 'ServiceLoader, ComputationManager, PlatformConfig, ReportNode, and Extension contracts.'
    math = library 'Math API' 'MatrixFactory and shared numerical abstractions.'

    loadflow_api -> iidm.network 'accepts Network and working variant'
    loadflow_api -> commons 'discovers provider and reports execution'
    loadflow_api -> math 'supplies matrix capability to providers'
    sensitivity_api -> iidm.network 'accepts Network and working variant'
    sensitivity_api -> contingency_api 'accepts contingency and action inputs'
    sensitivity_api -> commons 'discovers provider and reports execution'
    security_analysis_api -> iidm.network 'accepts Network and working variant'
    security_analysis_api -> contingency_api 'obtains contingencies'
    security_analysis_api -> loadflow_api 'uses load-flow parameters'
    security_analysis_api -> commons 'discovers provider and reports execution'
  }

}